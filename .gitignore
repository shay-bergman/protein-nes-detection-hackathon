# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Generated data, caches and results (regenerated by the pipeline; see README).
