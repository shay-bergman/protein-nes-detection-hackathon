data/*
!data/sample/
cache/
DB/
results/

# Model, embedding and other large binary artifacts
*.pt
*.pth
*.npy
*.npz
*.h5
*.pkl
*.pkl.gz
*.jsonl

# OS / Windows metadata
.DS_Store
*:Zone.Identifier
